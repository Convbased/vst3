<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <colors>
        <color name="Canvas" rgba="#1d1f21ff"/>
        <color name="Panel" rgba="#2c2e30ff"/>
        <color name="Field" rgba="#1d1f21ff"/>
        <color name="Border" rgba="#444648ff"/>
        <color name="Text" rgba="#ffffffff"/>
        <color name="Text Secondary" rgba="#e0e0e0ff"/>
        <color name="Muted" rgba="#a3a3a3ff"/>
        <color name="Quiet" rgba="#858585ff"/>
        <color name="Accent" rgba="#ff6600ff"/>
        <color name="Accent Soft" rgba="#ff983fff"/>
        <color name="Accent Pressed" rgba="#f26100ff"/>
    </colors>
    <control-tags>
        <control-tag name="UI::ApplyApiKey" tag="1000"/>
        <control-tag name="UI::ApiKeyInput" tag="1001"/>
        <control-tag name="UI::ApiKeyStatus" tag="1002"/>
        <control-tag name="UI::ClearApiKey" tag="1003"/>
        <control-tag name="UI::BalanceStatus" tag="1004"/>
        <control-tag name="UI::ProfileStatus" tag="1005"/>
    </control-tags>
    <gradients>
        <gradient name="Panel Surface">
            <color-stop rgba="#2c2e30ff" start="0"/>
            <color-stop rgba="#2c2e30ff" start="1"/>
        </gradient>
        <gradient name="Primary Button">
            <color-stop rgba="#ff6600ff" start="0"/>
            <color-stop rgba="#ff983fff" start="1"/>
        </gradient>
        <gradient name="Primary Button Pressed">
            <color-stop rgba="#f26100ff" start="0"/>
            <color-stop rgba="#f2913cff" start="1"/>
        </gradient>
        <gradient name="Secondary Button">
            <color-stop rgba="#444648ff" start="0"/>
            <color-stop rgba="#3b3d3fff" start="1"/>
        </gradient>
        <gradient name="Secondary Button Pressed">
            <color-stop rgba="#2c2e30ff" start="0"/>
            <color-stop rgba="#1d1f21ff" start="1"/>
        </gradient>
    </gradients>
    <template background-color="Canvas" background-color-draw-style="filled"
              class="CViewContainer" maxSize="560, 344" minSize="560, 344"
              mouse-enabled="true" name="view" opacity="1" origin="0, 0"
              size="560, 344" transparent="false" wants-focus="false">
        <view back-color="Canvas" class="CTextLabel" font="~ NormalFontVeryBig"
              font-antialias="true" font-color="Accent" frame-color="Canvas"
              frame-width="0" mouse-enabled="false" opacity="1" origin="20, 12"
              size="96, 28" style-no-frame="true" text-alignment="left"
              text-inset="0, 0" title="Convbased" transparent="true"/>
        <view back-color="Canvas" class="CTextLabel" font="~ NormalFontVeryBig"
              font-antialias="true" font-color="Text" frame-color="Canvas"
              frame-width="0" mouse-enabled="false" opacity="1" origin="118, 12"
              size="180, 28" style-no-frame="true" text-alignment="left"
              text-inset="0, 0" title="实时变声" transparent="true"/>
        <view back-color="Canvas" class="CTextLabel" font="~ NormalFontSmaller"
              font-antialias="true" font-color="Quiet" frame-color="Canvas"
              frame-width="0" mouse-enabled="false" opacity="1" origin="420, 18"
              size="120, 16" style-no-frame="true" text-alignment="right"
              text-inset="0, 0" title="VST3 BRIDGE" transparent="true"/>
        <view back-color="Canvas" class="CTextLabel" font="~ NormalFontSmall"
              font-antialias="true" font-color="Muted" frame-color="Canvas"
              frame-width="0" mouse-enabled="false" opacity="1" origin="20, 44"
              size="520, 18" style-no-frame="true" text-alignment="left"
              text-inset="0, 0" title="经本地桥接服务连接 Convbased"
              transparent="true"/>

        <view class="CGradientView" draw-antialiased="true" frame-color="Border"
              frame-width="1" gradient="Panel Surface" gradient-angle="90"
              gradient-style="linear" mouse-enabled="false" opacity="1"
              origin="20, 72" radial-center="0.5, 0.5" radial-radius="1"
              round-rect-radius="8" size="520, 136" transparent="false"/>
        <view background-color="Panel" class="CViewContainer" mouse-enabled="true"
              opacity="1" origin="20, 72" size="520, 136"
              sub-controller="ApiKeyController" transparent="true">
            <view back-color="Panel" class="CTextLabel" font="~ NormalFont"
                  font-antialias="true" font-color="Text Secondary" frame-color="Panel"
                  frame-width="0" mouse-enabled="false" opacity="1" origin="16, 12"
                  size="240, 20" style-no-frame="true" text-alignment="left"
                  text-inset="0, 0" title="API Key" transparent="true"/>
            <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller"
                  font-antialias="true" font-color="Quiet" frame-color="Panel"
                  frame-width="0" mouse-enabled="false" opacity="1" origin="360, 14"
                  size="144, 16" style-no-frame="true" text-alignment="right"
                  text-inset="0, 0" title="仅本次会话" transparent="true"/>
            <view back-color="Field" class="CTextEdit" control-tag="UI::ApiKeyInput"
                  default-value="0" font="~ NormalFont" font-antialias="true"
                  font-color="Text" frame-color="Border" frame-width="1"
                  immediate-text-change="true" max-value="1" min-value="0"
                  mouse-enabled="true" opacity="1" origin="16, 40"
                  placeholder-title="粘贴 CONVBASED_API_KEY" round-rect-radius="8"
                  secure-style="true" size="278, 36" style-no-frame="false"
                  style-round-rect="true" text-alignment="left" text-inset="12, 0"
                  title="" transparent="false" wants-focus="true"/>
            <view class="CTextButton" control-tag="UI::ApplyApiKey" default-value="0"
                  font="~ NormalFont" frame-color="Accent"
                  frame-color-highlighted="Accent Pressed" frame-width="0"
                  gradient="Primary Button" gradient-highlighted="Primary Button Pressed"
                  kick-style="true" max-value="1" min-value="0" mouse-enabled="true"
                  opacity="1" origin="304, 40" round-radius="8" size="110, 36"
                  text-alignment="center" text-color="Text"
                  text-color-highlighted="Text" title="连接" transparent="false"
                  wants-focus="true"/>
            <view class="CTextButton" control-tag="UI::ClearApiKey" default-value="0"
                  font="~ NormalFont" frame-color="Border"
                  frame-color-highlighted="Border" frame-width="1"
                  gradient="Secondary Button"
                  gradient-highlighted="Secondary Button Pressed" kick-style="true"
                  max-value="1" min-value="0" mouse-enabled="true" opacity="1"
                  origin="424, 40" round-radius="8" size="80, 36"
                  text-alignment="center" text-color="Text Secondary"
                  text-color-highlighted="Text" title="清除" transparent="false"
                  wants-focus="true"/>
            <view back-color="Panel" class="CTextLabel" control-tag="UI::ApiKeyStatus"
                  default-value="0" font="~ NormalFontSmall" font-antialias="true"
                  font-color="Text Secondary" frame-color="Panel" frame-width="0"
                  max-value="1" min-value="0" mouse-enabled="false" opacity="1"
                  origin="16, 84" size="488, 18" style-no-frame="true"
                  text-alignment="left" text-inset="0, 0"
                  title="尚未输入会话密钥，转换音频当前为静音。"
                  transparent="true"/>
            <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller"
                  font-antialias="true" font-color="Quiet" frame-color="Panel"
                  frame-width="0" mouse-enabled="false" opacity="1" origin="16, 106"
                  size="488, 16" style-no-frame="true" text-alignment="left"
                  text-inset="0, 0" title="密钥仅用于本次插件会话，不写入磁盘或工程文件。"
                  transparent="true"/>
        </view>

        <view class="CGradientView" draw-antialiased="true" frame-color="Border"
              frame-width="1" gradient="Panel Surface" gradient-angle="90"
              gradient-style="linear" mouse-enabled="false" opacity="1"
              origin="20, 220" radial-center="0.5, 0.5" radial-radius="1"
              round-rect-radius="8" size="520, 88" transparent="false"/>
        <view background-color="Panel" class="CViewContainer" mouse-enabled="false"
              opacity="1" origin="20, 220" size="520, 88" transparent="true">
            <view back-color="Panel" class="CTextLabel" font="~ NormalFont"
                  font-antialias="true" font-color="Text Secondary" frame-color="Panel"
                  frame-width="0" mouse-enabled="false" opacity="1" origin="16, 11"
                  size="240, 20" style-no-frame="true" text-alignment="left"
                  text-inset="0, 0" title="账户与设备" transparent="true"/>
            <view back-color="Panel" class="CTextLabel" font="~ NormalFontSmaller"
                  font-antialias="true" font-color="Quiet" frame-color="Panel"
                  frame-width="0" mouse-enabled="false" opacity="1" origin="288, 13"
                  size="216, 16" style-no-frame="true" text-alignment="right"
                  text-inset="0, 0" title="由 Web 控制台配置" transparent="true"/>
            <view back-color="Panel" class="CTextLabel" control-tag="UI::BalanceStatus"
                  font="~ NormalFontSmall" font-antialias="true"
                  font-color="Muted" frame-color="Panel" frame-width="0"
                  mouse-enabled="false" opacity="1" origin="16, 36" size="488, 18"
                  style-no-frame="true" text-alignment="left" text-inset="0, 0"
                  title="可用余额：--" transparent="true"/>
            <view back-color="Panel" class="CTextLabel" control-tag="UI::ProfileStatus"
                  font="~ NormalFontSmall" font-antialias="true"
                  font-color="Muted" frame-color="Panel" frame-width="0"
                  mouse-enabled="false" opacity="1" origin="16, 59" size="488, 18"
                  style-no-frame="true" text-alignment="left" text-inset="0, 0"
                  title="设备配置：未连接" transparent="true"/>
        </view>

        <view class="CGradientView" draw-antialiased="true" frame-color="Accent"
              frame-width="0" gradient="Primary Button" gradient-angle="90"
              gradient-style="linear" mouse-enabled="false" opacity="1"
              origin="20, 323" radial-center="0.5, 0.5" radial-radius="1"
              round-rect-radius="3" size="6, 6" transparent="false"/>
        <view back-color="Canvas" class="CTextLabel" font="~ NormalFontSmaller"
              font-antialias="true" font-color="Quiet" frame-color="Canvas"
              frame-width="0" mouse-enabled="false" opacity="1" origin="34, 318"
              size="506, 16" style-no-frame="true" text-alignment="left"
              text-inset="0, 0" title="请先启动本地桥接服务，转换音频会自动返回当前轨道。"
              transparent="true"/>
    </template>
</vstgui-ui-description>
